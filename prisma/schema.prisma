generator client {
  // Prisma 7 : le générateur "prisma-client" remplace "prisma-client-js"
  // et `output` est obligatoire (plus de génération dans node_modules).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // L'URL est fournie par prisma.config.ts (Prisma 7 ne lit plus .env tout seul).
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id String @id @default(cuid())
  /// Absent pour un compte créé uniquement via WhatsApp : le numéro de
  /// téléphone y sert d'identifiant (voir §Connexion sociale du README).
  email String? @unique
  name  String
  /// Non unique volontairement : plusieurs comptes de démonstration partagent
  /// un numéro. La connexion WhatsApp choisit alors le compte le plus ancien
  /// (voir src/server/whatsapp.ts).
  phone String?
  /// Vide pour un compte créé via Google, Facebook ou WhatsApp : ces clients
  /// n'ont pas de mot de passe tant qu'ils n'en définissent pas un.
  passwordHash String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  designs   Design[]
  orders    Order[]
  carts     Cart[]
  accounts  OAuthAccount[]

  @@index([role])
}

/// Rattachement d'un compte local à une identité chez un fournisseur externe.
/// Un même client peut avoir Google *et* Facebook sur le même compte.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  /// "google" ou "facebook" (voir src/server/oauth.ts).
  provider          String
  /// Identifiant du compte chez le fournisseur (`sub` Google, `id` Facebook).
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Code de connexion envoyé sur WhatsApp.
///
/// Le code n'est jamais stocké en clair, il a une durée de vie courte et un
/// nombre d'essais limité : sans cela, six chiffres se devineraient en quelques
/// secondes.
model LoginCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameFr        String
  nameMg        String
  descriptionFr String?
  descriptionMg String?
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  categoryId    String
  nameFr        String
  nameMg        String
  descriptionFr String
  descriptionMg String?
  imageUrl      String?
  /// Prix de référence en Ariary (MGA), utilisé quand un format est choisi.
  basePriceMga  Int
  /// Délai de production indicatif, en jours ouvrés.
  leadTimeDays  Int      @default(2)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  designs  Design[]
  items    CartItem[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

model ProductVariant {
  /// Support / format : "10x15 cm", "A3", "Mug 325 ml"...
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  label      String
  widthMm    Int?
  heightMm   Int?
  pageCount  Int      @default(1)
  priceMga   Int
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@index([productId, isActive])
}

// ---------------------------------------------------------------------------
// Éditeur (créations de type Canva)
// ---------------------------------------------------------------------------

model Design {
  id      String @id @default(cuid())
  /// Propriétaire si le créateur est connecté.
  userId  String?
  /// Sinon, identifiant de la session visiteur qui a créé la composition.
  /// Sans lui, toutes les créations anonymes seraient accessibles entre elles
  /// puisque `userId` vaut `null` pour chacune.
  guestSessionId String?
  title   String @default("Création sans titre")

  /// Dimensions du plan de travail en pixels CSS.
  canvasWidth  Int
  canvasHeight Int
  /// Largeur réelle du support en mm, pour calculer l'export à 300 dpi.
  targetWidthMm  Int?
  targetHeightMm Int?

  /// Document complet de l'éditeur (calques, textes, images, filtres).
  document  Json
  /// Aperçu basse résolution stocké sur disque.
  previewPath  String?
  thumbnailPath String?

  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  items   CartItem[]
  orderItems OrderItem[]

  @@index([userId, updatedAt])
  @@index([guestSessionId, updatedAt])
}

// ---------------------------------------------------------------------------
// Panier
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  /// Un panier appartient soit à un utilisateur, soit à une session invitée.
  userId    String?
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  productId     String
  variantId     String
  designId      String?
  quantity      Int     @default(1)
  /// Prix figé au moment de l'ajout (en Ariary).
  unitPriceMga  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  design  Design?         @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Zones de livraison (Madagascar)
// ---------------------------------------------------------------------------

enum DeliveryMode {
  PICKUP
  HOME_DELIVERY
}

model DeliveryZone {
  id          String @id @default(cuid())
  name        String
  region      String
  city        String
  feeMga      Int
  etaDaysMin  Int    @default(1)
  etaDaysMax  Int    @default(3)
  isActive    Boolean @default(true)

  orders Order[]

  @@index([isActive, city])
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH_ON_DELIVERY
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id        String @id @default(cuid())
  /// Référence lisible communiquée au client, ex. MP-2026-000123
  reference String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String
  customerPhone String

  deliveryMode   DeliveryMode
  deliveryZoneId String?
  /// Libellé figé au moment de la commande, même si la zone est renommée ensuite.
  deliveryZoneLabel String?
  addressLine    String?
  city           String
  region         String
  deliveryFeeMga Int    @default(0)

  subtotalMga Int
  totalMga    Int
  currency    String @default("MGA")

  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  /// Numéro de transaction Mobile Money saisi par le client.
  paymentReference String?
  /// Numéro marchand à créditer, figé pour traçabilité.
  paymentTarget    String?
  paidAt           DateTime?

  status     OrderStatus @default(PENDING)
  customerNote String?
  adminNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  items  OrderItem[]
  events OrderEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  designId     String?
  productName  String
  variantLabel String
  quantity     Int
  unitPriceMga Int
  lineTotalMga Int
  previewPath  String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  design  Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actor     String      @default("system")
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
