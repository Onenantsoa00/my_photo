# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# PostgreSQL local. Remplacer par l'URL de l'hébergeur en production.
DATABASE_URL="postgresql://myphoto:myphoto_dev_pwd@127.0.0.1:5432/myphoto"

# ---------------------------------------------------------------------------
# Session (JWT signé, cookie httpOnly)
# ---------------------------------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="remplacer-par-un-secret-de-64-caracteres"

# ---------------------------------------------------------------------------
# Encaissement Mobile Money (Madagascar)
# ---------------------------------------------------------------------------
# Numéros marchand affichés au client lors du paiement Mobile Money déclaratif.
# Le client envoie l'argent puis saisit son numéro de transaction ;
# un administrateur valide le paiement dans le back-office.
PAYMENT_MVOLA_NUMBER="034 00 000 00"
PAYMENT_ORANGE_MONEY_NUMBER="032 00 000 00"
PAYMENT_AIRTEL_MONEY_NUMBER="033 00 000 00"
PAYMENT_BANK_IBAN="MG46 0000 0000 0000 0000 0000 000"

# ---------------------------------------------------------------------------
# Adresse publique du site (facultatif)
# ---------------------------------------------------------------------------
# Sert à construire les URL de retour OAuth déclarées chez Google et Facebook
# (`https://votre-domaine/api/auth/google/callback`). En développement, l'origine
# de la requête est utilisée si cette variable est absente.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Connexion avec Google (console Google Cloud → Identifiants OAuth 2.0)
# ---------------------------------------------------------------------------
# URI de redirection à déclarer : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Connexion avec Facebook (developers.facebook.com → Facebook Login)
# ---------------------------------------------------------------------------
# URI de redirection à déclarer : http://localhost:3000/api/auth/facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ---------------------------------------------------------------------------
# Connexion par code WhatsApp (WhatsApp Business Cloud API, Meta)
# ---------------------------------------------------------------------------
# Sans ces valeurs, l'envoi par WhatsApp est désactivé. En développement
# (NODE_ENV ≠ production), le code est alors affiché à l'écran pour tester le
# parcours ; en production, la connexion WhatsApp répond « non configuré ».
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------------
# Stockage des fichiers
# ---------------------------------------------------------------------------
# Répertoire des photos envoyées et des aperçus de créations (hors /public).
UPLOAD_DIR="storage/uploads"
